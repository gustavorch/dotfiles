@define-color bg    #1a1b26; 
@define-color fg    #a9b1d6; 
@define-color blk   #32344a; 
@define-color red   #f7768e; 
@define-color grn   #9ece6a; 
@define-color ylw   #e0af68; 
@define-color blu   #7aa2f7; 
@define-color mag   #ad8ee6; 
@define-color cyn   #0db9d7; 
@define-color brblk #444b6a; 
@define-color white #ffffff;

* {
  border: none;
  border-radius: 0;
  min-height: 0;
  font-family: "JetBrainsMono Nerd Font";
  font-size: 14px;
  font-weight: Bold;
  padding: 0;
}

window#waybar {
  background-color: @bg;
  color: @fg;
}

tooltip {
  background-color: #222222;
  color: #e6e6e6;
}

#clock,
#tray,
#cpu,
#memory,
#battery,
#network,
#pulseaudio {
  margin: 2px 2px 0px 0px;
  padding: 2px 8px;
  color: #e6e6e6;
}

#workspaces button {
  color: #e6e6e6;
}

#workspaces button.focused {
  background-color: #005577; /* classic sway blue */
  color: #ffffff;           /* readable on blue */
}

#workspaces button.active {
  background-color: #222222;
  color: #285577;
}

#battery,
#tray,
#clock,
#cpu,
#pulseaudio,
#memory {
  color: @white;
}
